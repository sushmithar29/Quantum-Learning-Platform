# ── Environment variables for QuantumLab IBM Backend ──────────────────────
# Copy this file to .env and fill in values.
# NEVER commit .env to git.

# CORS: comma-separated list of allowed frontend origins.
# Use * only for local development.
QIBM_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Port the server listens on (Render / Cloud Run will inject PORT automatically)
PORT=8001

# DEVELOPMENT ONLY: owner's IBM key for running record_replay.py locally.
# This key is NEVER used to serve visitor traffic.
# It is never read by the FastAPI app at request time.
# Remove or leave empty in production.
IBM_QUANTUM_API_KEY=your_ibm_quantum_api_key_here
